DEF RESCUE_ROBOT RescueBot { translation -4.6 -3.6 0 rotation 0 0 1 0.0 }

DEF EVALUATOR Robot {
  name "Scenario evaluator"
  supervisor TRUE
  customData "config/scenario_loop.json"
  controller "scenario_supervisor"
  children [ Receiver { name "mission events" channel 17 } ]
}
